rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function identityMatches(record) {
      return signedIn() && (
        (request.auth.token.email_verified == true &&
         request.auth.token.email == record.gmail) ||
        request.auth.token.phone_number == record.phoneE164
      );
    }

    function validUmid(umid) {
      return umid.matches('^[0-9A-F]{24}$');
    }

    match /umids/{umid} {
      allow get: if identityMatches(resource.data);
      allow list: if false;

      allow create: if validUmid(umid) &&
        request.resource.data.umid == umid &&
        identityMatches(request.resource.data);

      allow update: if identityMatches(resource.data) &&
        identityMatches(request.resource.data) &&
        request.resource.data.umid == resource.data.umid &&
        request.resource.data.gmail == resource.data.gmail &&
        request.resource.data.phoneE164 == resource.data.phoneE164;

      allow delete: if false;
    }
  }
}
